# ONE EYE - Industrial Safety Platform Configuration

APP_ENV=development
PORT=8001
HOST=0.0.0.0

# Database (PostgreSQL with automatic SQLite fallback for zero-config local run)
DATABASE_URL=sqlite+aiosqlite:///./oneeye.db
# DATABASE_URL=postgresql+asyncpg://oneeye:oneeye_pass@localhost:5432/oneeye_db

# Computer Vision & Models
DEMO_MODE=false
VIDEO_SOURCE=./videos/demo/factory_safety.mp4
DEFAULT_CAMERA_ID=CAM_01
MODEL_DEVICE=mps
YOLO_MODEL_PATH=yolov8n.pt
PPE_MODEL_PATH=models/ppe_yolov8n.pt
YOLO_CONFIDENCE=0.25
INFERENCE_FPS=15

# Storage & Evidence
EVIDENCE_DIR=./evidence
MAX_EVIDENCE_AGE_DAYS=30

# Optional Reasoning & AI Providers
ENABLE_QWEN=false
QWEN_API_KEY=
QWEN_MODEL_NAME=qwen-vl-plus

# Alert Channels
ENABLE_TTS=false
SARVAM_API_KEY=
ENABLE_WHATSAPP=false
WHATSAPP_API_KEY=
WHATSAPP_PHONE=
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_RELAY=false
RELAY_TYPE=mock

# Risk Engine Thresholds (0-100)
RISK_THRESHOLD_ADVISORY=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80
EXPOSURE_ESCALATION_SECONDS=5.0
TRACK_LOSS_RESOLUTION_SECONDS=3.0
